            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/products/{{created_product_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "products",
            "{{created_product_id}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"{{updated_title}}\",\n  \"price\": {{price}},\n  \"description\": \"{{description}}\",\n  \"image\": \"{{image}}\",\n  \"category\": \"{{category}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Response is valid JSON\", function () { pm.expect(()=>pm.response.json()).not.to.throw(); });",
              "pm.test(\"Response is a non-empty object\", function () { pm.expect(pm.response.json()).to.be.an(\"object\").and.not.empty; });",
              "pm.test(\"Updated product matches values\", function () { let d=pm.response.json();pm.expect(String(d.id)).to.eql(String(pm.collectionVariables.get(\"created_product_id\")));pm.expect(d.title).to.eql(pm.collectionVariables.get(\"updated_title\"));pm.expect(Number(d.price)).to.eql(Number(pm.collectionVariables.get(\"price\"))); });"
            ]
          }
        }
      ]
    },
