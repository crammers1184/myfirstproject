    },
    {
      "name": "[TC011] Delete a Product",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{base_url}}/products/{{created_product_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "products",
            "{{created_product_id}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200 or 204\", function () { pm.expect([200, 204]).to.include(pm.response.code); });",
              "pm.test(\"Delete response is empty or valid JSON\", function () { const body=pm.response.text(); if(body.trim().length){ pm.expect(()=>pm.response.json()).not.to.throw(); } });",
              "pm.test(\"Returned deleted product ID matches requested ID when present\", function () { const body=pm.response.text(); if(body.trim().length){ const data=pm.response.json(); pm.expect(data).to.be.an(\"object\"); if(data.id!==undefined){ pm.expect(String(data.id)).to.eql(String(pm.collectionVariables.get(\"created_product_id\"))); } } });"
            ]
          }
        }
      ]
    }
  ]
}
