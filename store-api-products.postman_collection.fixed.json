              "pm.test(\"Response is a non-empty array\", function () { pm.expect(pm.response.json()).to.be.an(\"array\").and.not.empty; });",
              "pm.test(\"Categories are strings\", function () { pm.response.json().forEach(c=>pm.expect(c).to.be.a(\"string\").and.not.empty); });"
            ]
          }
        }
      ]
    },
    {
      "name": "[TC007] Get Products by Category",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/products/category/{{category}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "products",
            "category",
            "{{category}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Response is valid JSON\", function () { pm.expect(()=>pm.response.json()).not.to.throw(); });",
              "pm.test(\"Response is a non-empty array\", function () { pm.expect(pm.response.json()).to.be.an(\"array\").and.not.empty; });",
              "pm.test(\"Every product belongs to requested category\", function () { pm.response.json().forEach(p=>pm.expect(p.category.toLowerCase()).to.eql(pm.collectionVariables.get(\"category\").toLowerCase())); });"
            ]
          }
        }
      ]
    },
    {
      "name": "[TC008] Add a Product",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/products",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "products"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"{{title}}\",\n  \"price\": {{price}},\n  \"description\": \"{{description}}\",\n  \"image\": \"{{image}}\",\n  \"category\": \"{{category}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "pm.test(\"Response is valid JSON\", function () { pm.expect(()=>pm.response.json()).not.to.throw(); });",
              "pm.test(\"Response is a non-empty object\", function () { pm.expect(pm.response.json()).to.be.an(\"object\").and.not.empty; });",
              "pm.test(\"Returned product matches request and ID is saved\", function () { let d=pm.response.json();pm.expect(d.title).to.eql(pm.collectionVariables.get(\"title\"));pm.expect(Number(d.price)).to.eql(Number(pm.collectionVariables.get(\"price\")));pm.expect(d.category).to.eql(pm.collectionVariables.get(\"category\"));pm.expect(d).to.have.property(\"id\");pm.collectionVariables.set(\"created_product_id\",d.id); });"
            ]
          }
        }
      ]
    },
    {
      "name": "[TC009] Update a Product",
