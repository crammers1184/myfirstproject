{
  "info": {
    "name": "Store API - Products",
    "description": "Separate Products collection. Start with read requests, then create, update, patch, and delete the generated product. Request order is preserved. Generated test records are fake API examples; writes are simulated and do not persist in the service.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://fakestoreapi.com",
      "type": "string"
    },
    {
      "key": "product_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "product_limit",
      "value": "12",
      "type": "string"
    },
    {
      "key": "sort",
      "value": "asc",
      "type": "string"
    },
    {
      "key": "category",
      "value": "electronics",
      "type": "string"
    },
    {
      "key": "title",
      "value": "QA Sample Product",
      "type": "string"
    },
    {
      "key": "updated_title",
      "value": "QA Updated Product",
      "type": "string"
    },
    {
      "key": "patched_title",
      "value": "QA Patched Product",
      "type": "string"
    },
    {
      "key": "price",
      "value": "29.99",
      "type": "string"
    },
    {
      "key": "description",
      "value": "Synthetic product created by the Postman collection.",
      "type": "string"
    },
    {
      "key": "image",
      "value": "https://i.pravatar.cc",
      "type": "string"
    },
    {
      "key": "created_product_id",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "[TC001] Get Single Product",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/products/{{product_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "products",
            "{{product_id}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Response is valid JSON\", function () { pm.expect(()=>pm.response.json()).not.to.throw(); });",
              "pm.test(\"Response is a non-empty object\", function () { pm.expect(pm.response.json()).to.be.an(\"object\").and.not.empty; });",
              "pm.test(\"Product ID matches request\", function () { pm.expect(String(pm.response.json().id)).to.eql(String(pm.collectionVariables.get(\"product_id\"))); });",
              "pm.test(\"Product has core fields\", function () { [\"title\",\"price\",\"description\",\"category\"].forEach(k=>pm.expect(pm.response.json()).to.have.property(k)); });"
            ]
          }
        }
      ]
    },
    {
      "name": "[TC002] Get All Products",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/products",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "products"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Response is valid JSON\", function () { pm.expect(()=>pm.response.json()).not.to.throw(); });",
              "pm.test(\"Response is a non-empty array\", function () { pm.expect(pm.response.json()).to.be.an(\"array\").and.not.empty; });",
              "pm.test(\"Products have expected fields\", function () { pm.response.json().forEach(p=>{pm.expect(p).to.have.property(\"id\");pm.expect(p.title).to.be.a(\"string\");pm.expect(p.price).to.be.a(\"number\");}); });"
            ]
          }
        }
      ]
    },
    {
      "name": "[TC003] Get Limited Products",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/products?limit={{product_limit}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "products"
          ],
          "query": [
            {
              "key": "limit",
              "value": "{{product_limit}}"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Response is valid JSON\", function () { pm.expect(()=>pm.response.json()).not.to.throw(); });",
              "pm.test(\"Response is a non-empty array\", function () { pm.expect(pm.response.json()).to.be.an(\"array\").and.not.empty; });",
              "pm.test(\"Returned count matches limit\", function () { pm.expect(pm.response.json().length).to.eql(Number(pm.collectionVariables.get(\"product_limit\"))); });"
            ]
          }
        }
      ]
    },
    {
      "name": "[TC004] Get Sorted Products",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/products?sort={{sort}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "products"
          ],
          "query": [
            {
              "key": "sort",
              "value": "{{sort}}"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Response is valid JSON\", function () { pm.expect(()=>pm.response.json()).not.to.throw(); });",
              "pm.test(\"Response is a non-empty array\", function () { pm.expect(pm.response.json()).to.be.an(\"array\").and.not.empty; });",
              "pm.test(\"IDs follow requested sort\", function () { let ids=pm.response.json().map(x=>Number(x.id));let sorted=[...ids].sort((a,b)=>pm.collectionVariables.get(\"sort\")===\"desc\"?b-a:a-b);pm.expect(ids).to.eql(sorted); });"
            ]
          }
        }
      ]
    },
    {
      "name": "[TC005] Get Products with Limit and Sort",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/products?limit={{product_limit}}&sort={{sort}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "products"
          ],
          "query": [
            {
              "key": "limit",
              "value": "{{product_limit}}"
            },
            {
              "key": "sort",
              "value": "{{sort}}"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Response is valid JSON\", function () { pm.expect(()=>pm.response.json()).not.to.throw(); });",
              "pm.test(\"Response is a non-empty array\", function () { pm.expect(pm.response.json()).to.be.an(\"array\").and.not.empty; });",
              "pm.test(\"Count matches limit and IDs follow sort\", function () { let a=pm.response.json(),ids=a.map(x=>Number(x.id)),sorted=[...ids].sort((x,y)=>pm.collectionVariables.get(\"sort\")===\"desc\"?y-x:x-y);pm.expect(a.length).to.eql(Number(pm.collectionVariables.get(\"product_limit\")));pm.expect(ids).to.eql(sorted); });"
            ]
          }
        }
      ]
    },
    {
      "name": "[TC006] Get All Categories",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
