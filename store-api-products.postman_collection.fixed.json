            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Response is valid JSON\", function () { pm.expect(()=>pm.response.json()).not.to.throw(); });",
              "pm.test(\"Response is a non-empty object\", function () { pm.expect(pm.response.json()).to.be.an(\"object\").and.not.empty; });",
              "pm.test(\"Patched product has requested fields\", function () { let d=pm.response.json();pm.expect(String(d.id)).to.eql(String(pm.collectionVariables.get(\"created_product_id\")));pm.expect(d.title).to.eql(pm.collectionVariables.get(\"patched_title\"));pm.expect(d.category).to.eql(pm.collectionVariables.get(\"category\")); });"
